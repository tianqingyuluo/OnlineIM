# ============================================
# OnlineIM 测试环境部署变量(dev / tianqing-dev 分支)
# 复制为 .env 并按需修改,首次部署时由运维初始化
# 与生产隔离:独立数据卷、独立端口、独立密码
# ============================================

# 对外访问端口(nginx,与生产 80 区分)
LISTEN_PORT=81

# MySQL root 密码(部署初始化时使用)
MYSQL_ROOT_PASSWORD=change-me-dev

# MinIO 访问凭证(对象存储)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-dev-too

# OSS 类型: minio / s3 / aliyun / tencent
OSS_TYPE=minio

# 默认存储桶(后端上传时若不存在会自动创建)
OSS_DEFAULT_BUCKET=onlineim-dev
