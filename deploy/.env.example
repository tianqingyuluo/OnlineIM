# ============================================
# OnlineIM 生产环境部署变量(prod)
# 复制为 .env 并按需修改,首次部署时由运维初始化
# 注意:密码修改后需同步 docker compose up -d 重建相关容器
# ============================================

# 对外访问端口(nginx)
LISTEN_PORT=80

# MySQL root 密码(部署初始化时使用)
MYSQL_ROOT_PASSWORD=change-me

# MinIO 访问凭证(对象存储)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# OSS 类型: minio / s3 / aliyun / tencent
OSS_TYPE=minio

# 默认存储桶(后端上传时若不存在会自动创建)
OSS_DEFAULT_BUCKET=onlineim
